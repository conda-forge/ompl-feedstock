From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Silvio Traversaro <silvio@traversaro.it>
Date: Mon, 7 Sep 2026 12:20:00 +0200
Subject: [PATCH] Fix shared library builds on Windows

Link the Windows system libraries required by MachineSpecs.cpp for both
static and shared builds.

When building OMPL as a shared library with MSVC, automatically export
the library symbols. MinGW already handles this through
--export-all-symbols.
---
 src/ompl/CMakeLists.txt | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/src/ompl/CMakeLists.txt b/src/ompl/CMakeLists.txt
index 0cbd4979c..xxxxxxxxx 100644
--- a/src/ompl/CMakeLists.txt
+++ b/src/ompl/CMakeLists.txt
@@ -55,6 +55,10 @@ target_link_libraries(ompl
     PRIVATE
         "$<$<BOOL:${OMPL_HAVE_SPOT}>:Spot::Spot>")

+if(WIN32)
+    target_link_libraries(ompl PRIVATE psapi ws2_32)
+endif()
+
 if(NOT SKBUILD)
     set_target_properties(ompl PROPERTIES VERSION "${PROJECT_VERSION}")
 endif()
@@ -63,15 +67,12 @@ if (OMPL_BUILD_SHARED)
     if(NOT SKBUILD)
         set_target_properties(ompl PROPERTIES SOVERSION "${OMPL_ABI_VERSION}")
     endif()
-    if (MINGW)
-        target_link_libraries(ompl PRIVATE psapi ws2_32)
+    if (MSVC)
+        set_target_properties(ompl PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+    elseif (MINGW)
         set_target_properties(ompl PROPERTIES LINK_FLAGS "-Wl,--export-all-symbols")
     endif()
-else()
-    if (MSVC)
-        set_target_properties(ompl PROPERTIES STATIC_LIBRARY_FLAGS "psapi.lib ws2_32.lib")
-    elseif (MINGW)
-        target_link_libraries(ompl PRIVATE psapi ws2_32)
-    endif()
 endif()
